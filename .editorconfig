root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,props,csproj}]
indent_size = 2

[*.cs]
# Samma radlängd som ruff i Python-repot.
max_line_length = 100
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

[*.sln]
end_of_line = crlf

[backend/tests/**.cs]
# Test names read as sentences: Health_returns_503_when_database_is_unreachable.
dotnet_diagnostic.CA1707.severity = none

[backend/src/Reacher.Data/Migrations/**.cs]
# Written by dotnet ef. Analyzers and dotnet format skip generated code.
generated_code = true
