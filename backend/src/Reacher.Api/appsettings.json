{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Scb": {
    "BaseUrl": "https://apiafr.scb.se/v1",
    "PageSize": 5000
  },
  "Bolagsverket": {
    "TokenUrl": "https://portal.api.bolagsverket.se/oauth2/token",
    "ApiUrl": "https://gw.api.bolagsverket.se/vardefulla-datamangder/v1",
    "Scope": "vardefulla-datamangder:read",
    "Years": 3,
    "TagMap": [
      {
        "Tag": "se-gen-base:Nettoomsattning",
        "Fact": "revenue"
      },
      {
        "Tag": "se-gen-base:AretsResultat",
        "Fact": "net_result"
      }
    ]
  },
  "Ingest": {
    "FreshnessDays": 30,
    "AllowedLegalForms": [ "49" ]
  },
  "Brave": {
    "MonthlyCap": 1500,
    "RequestsPerSecond": 1,
    "UseFake": false
  },
  "PageSpeed": {
    "Strategy": "mobile",
    "TimeoutSeconds": 90
  },
  "ReworkScore": {
    "PerformanceWeight": 0.4,
    "AccessibilityWeight": 0.2,
    "BestPracticesWeight": 0.2,
    "SeoWeight": 0.2,
    "MissingHttpsPenalty": 15,
    "MissingViewportPenalty": 15,
    "StaleCopyrightPenalty": 10,
    "StaleCopyrightYears": 3
  }
}
