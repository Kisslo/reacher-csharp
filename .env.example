# Mall för lokala API-nycklar (D24). Bara namn här, aldrig värden.
#   1. Kopiera filen till .env (gitignorerad) och fyll i dina nycklar där.
#   2. .NET läser inte .env själv. Ladda in den innan körning:
#        bash:       set -a; source .env; set +a; dotnet run --project <projekt>
#        PowerShell: Get-Content .env | ? { $_ -match '^\w+=' } | % { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# Läcker en nyckel ut (commit, issue, skärmdump): rotera den. Att ta bort committen räcker inte.
SCB_API_KEY=
# Bolagsverket (T1-14): OAuth2-klientuppgifter från utvecklarportalen.
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
