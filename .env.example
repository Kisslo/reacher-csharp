# Names only. Do not put real keys in this file. Copy it to .env and fill in .env.
# Docker Compose reads .env. Local `dotnet run` does not: use `dotnet user-secrets` (see the README).
# ASP.NET Core maps "__" to ":".
# A leaked key is rotated. Deleting the commit is not enough.

# Required in every mode, also with the fakes on. A .env copied from this file without
# these filled in makes the API container stop at startup.
# Scb__ApiKey is always used: the code lists and the search check call the real SCB.
Scb__ApiKey=
Bolagsverket__ClientId=
Bolagsverket__ClientSecret=
PageSpeed__ApiKey=

# Required only when Brave__UseFake=false.
Brave__ApiKey=

# Empty means the Compose default: true (fakes on).
Ingest__UseFakeCoordinator=
Brave__UseFake=

# Only for the Render test deployment (D17). Empty means off in Docker Compose.
AccessGate__Enabled=
AccessGate__Password=
